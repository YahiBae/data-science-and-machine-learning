    "def is_prime(n):\n",
    "    if n < 2:\n",
    "        return False\n",
    "\n",
    "    for i in range(2, int(n ** 0.5) + 1):\n",
    "        if n % i == 0:\n",
    "            return False\n",
    "\n",
    "    return True\n",
    "\n",
    "\n",
    "prime_numbers = list(filter(is_prime, test_numbers))\n",
    "\n",
    "print(prime_numbers)\n"
   ]

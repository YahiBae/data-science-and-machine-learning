    "from abc import ABC, abstractmethod\n",
    "\n",
    "class Shape(ABC):\n",
    "    @abstractmethod\n",
    "    def area(self):\n",
    "        pass\n",
    "\n",
    "    @abstractmethod\n",
    "    def volume(self):\n",
    "        return \"This method should be implemented in the subclass\"\n",
    "\n"
   ]
